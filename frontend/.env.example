# Set these in Netlify after deploying the backend publicly.
VITE_API_URL=https://your-public-backend-url.com/api
VITE_SOCKET_URL=https://your-public-backend-url.com
# WebRTC needs a public STUN server; add TURN credentials for viewers behind strict NATs.
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
# Optional JSON override, for example: [{"urls":"stun:..."},{"urls":"turn:...","username":"...","credential":"..."}]
VITE_WEBRTC_ICE_SERVERS=
