NODE_ENV=development
PORT=5001
# Include both local development and the deployed Netlify frontend.
FRONTEND_URL=http://localhost:5173,https://lively-caramel-4dddfe.netlify.app
MONGODB_URI=mongodb://127.0.0.1:27017/streamconnect
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
COOKIE_NAME=streamconnect_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Optional integrations used by the existing streaming features.
YOUTUBE_API_KEY=replace-with-youtube-api-key

# Optional TURN server for browser connectivity where direct paths are unavailable.
# Example: turns:turn.example.com:5349
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# LiveKit Cloud or self-hosted LiveKit. Keep the API key and secret backend-only.
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret


